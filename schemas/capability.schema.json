{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sca://schemas/capability.schema.json",
  "title": "Capability",
  "description": "A documented capability, with fields designed for future research. Unknown fields stay null and display as 'Not yet documented'. 'family' in the specification is stored relationally as family_id. List fields hold references to other entities populated in later stages. Types for recovery_time, recovery_difficulty, repair_radius and recovery_radius are provisional and refined in Stages 8-9.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "code", "name", "family_id"],
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "family_id": { "type": "string", "description": "References CapabilityFamily.id" },
    "short_description": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "historical_status": { "type": ["string", "null"] },
    "living_status": { "type": ["string", "null"], "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", null] },
    "evidence_level": { "type": ["string", "null"], "enum": ["E0", "E1", "E2", "E3", "E4", "E5", null] },
    "verification_status": { "type": ["string", "null"] },
    "regions": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "practitioners": { "type": ["array", "null"], "items": { "type": ["string", "null"] }, "description": "References to Practitioner records" },
    "apprentices": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "knowledge_holders": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "materials": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "tools": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "dependencies": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "modern_equivalent": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "fallback": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "failure_scenarios": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "recovery_time": { "type": ["string", "null"] },
    "recovery_difficulty": { "type": ["string", "null"] },
    "repair_radius": { "type": ["string", "null"] },
    "recovery_radius": { "type": ["string", "null"] },
    "economic_role": { "type": ["string", "null"] },
    "environmental_role": { "type": ["string", "null"] },
    "knowledge_role": { "type": ["string", "null"] },
    "criticality": { "type": ["string", "null"] },
    "centrality": { "type": ["string", "null"] },
    "reproducibility": { "type": ["string", "null"] },
    "fallback_value": { "type": ["string", "null"] },
    "graph_leverage": { "type": ["string", "null"] },
    "irreplaceability": { "type": ["string", "null"] },
    "preservation_urgency": { "type": ["string", "null"] },
    "external_dependency": { "type": ["string", "null"] },
    "knowledge_concentration": { "type": ["string", "null"] },
    "action": { "type": ["string", "null"], "enum": ["RECOVER", "PRESERVE", "VALIDATE", "MODERNIZE", "BUILD", "BACKUP", "DOCUMENT", null] },
    "priority_flags": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "documentation_status": { "type": ["string", "null"] },
    "transmission_status": { "type": ["string", "null"] },
    "capability_maturity": { "type": ["string", "null"], "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9", null] },
    "reproduction_pathway": { "type": ["string", "null"] },
    "stewardship_notes": { "type": ["string", "null"] },
    "safety_notes": { "type": ["string", "null"] },
    "limitations": { "type": ["string", "null"] },
    "source_ids": { "type": ["array", "null"], "items": { "type": ["string", "null"] }, "description": "References to EvidenceSource records" },
    "reviewer": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] }
  }
}
